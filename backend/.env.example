PORT=3001
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Origine(s) autorisées en CORS, séparées par des virgules si plusieurs (voir ForClaude/SECURITY.md)
# Exemple avec plusieurs sessions locales simultanées (recette, une origine = un hostname du fichier hosts) :
# FRONTEND_URL=http://localhost:5173,http://rc.vigie.local:5173,http://cds.vigie.local:5173,http://cb.vigie.local:5173,http://admin.vigie.local:5173,http://demandeur.vigie.local:5173
FRONTEND_URL=http://localhost:5173
# Accès lecture seule de Claude Code à la base (audit/vérification) — rôle dédié claude_readonly,
# jamais service_role ni postgres. Voir ForClaude/SECURITY.md §7 pour le script de création du rôle.
DATABASE_URL_READONLY=postgresql://claude_readonly:password@host:5432/postgres
# Chemin de l'exécutable LibreOffice (génération PDF de la fiche FAD, demandeAchat.service.ts#genererFadPdf
# via pdf/fadPdfGenerator.ts) — optionnel, défaut "soffice" (doit alors être sur le PATH). À définir en local
# sous Windows si LibreOffice n'est pas sur le PATH, ex. "C:\Program Files\LibreOffice\program\soffice.exe".
# Sur Railway, l'exécutable est installé via nixpacks.toml (racine du repo), pas besoin de cette variable.
SOFFICE_PATH=
# Valeur temporaire utilisée par database/seeds/resetAllPasswords.ts — jamais en dur dans le code
# source (voir le script). Ne définir que ponctuellement, le temps de lancer le script.
RESET_PASSWORD_VALUE=
